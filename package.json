{
  "name": "that-book",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "That Book \u2014 remember the story, forget the title. Local Bayesian book-guessing game for the 2026 IST-Tech IT Arena Hackathon.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:engine": "tsc -p tsconfig.engine.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "simulate": "tsx scripts/simulate.ts",
    "validate": "python3 scripts/validate_catalog.py src/data/fixture.catalog.json --bank data/question_bank.json",
    "test:py": "python3 -m unittest discover -s tests -p \"test_*.py\"",
    "simulate:truth": "tsx scripts/simulate.ts --truth data/truth/fixture_supported_truth.json --out reports/simulation_truth.json",
    "proxy": "node server/library-proxy.mjs",
    "verify": "npm run typecheck && npm test && npm run test:py && npm run validate && vite build"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
