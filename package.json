{
  "name": "that-book",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "That Book — remember the story, forget the title. Local Bayesian book-guessing game for the 2026 IST-Tech IT Arena Hackathon.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:engine": "tsc -p tsconfig.engine.json --noEmit",
    "test": "tsx --test \"tests/*.test.ts\"",
    "simulate": "tsx scripts/simulate.ts",
    "validate": "node scripts/py.mjs scripts/validate_catalog.py src/data/fixture.catalog.json --bank data/question_bank.json",
    "test:py": "node scripts/py.mjs -m unittest discover -s tests -p \"test_*.py\"",
    "simulate:truth": "tsx scripts/simulate.ts --truth data/truth/fixture_supported_truth.json --out reports/simulation_truth.json",
    "proxy": "node server/library-proxy.mjs",
    "verify": "npm run typecheck && npm test && npm run test:py && npm run validate && npm run validate:cmu && vite build",
    "validate:cmu": "node scripts/py.mjs scripts/validate_catalog.py src/data/cmu.catalog.json --bank data/cmu/question_bank_core.json --max-warnings 3",
    "catalog:research": "node scripts/py.mjs scripts/merge_research.py && node scripts/py.mjs scripts/build_cmu_catalog.py --limit 500 --gate none && tsx scripts/gate_catalog.ts",
    "dev:cmu": "vite --mode cmu"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
