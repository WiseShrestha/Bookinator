{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "That Book source-grounded matrix response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "books"
  ],
  "properties": {
    "books": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "book_id",
          "answers"
        ],
        "properties": {
          "book_id": {
            "type": "string"
          },
          "answers": {
            "type": "array",
            "minItems": 64,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "question_id",
                "p_yes",
                "status",
                "source_id",
                "evidence_quote",
                "premise_safe",
                "reviewed"
              ],
              "properties": {
                "question_id": {
                  "type": "string",
                  "pattern": "^q(0[1-9]|[1-5][0-9]|6[0-4])$"
                },
                "p_yes": {
                  "type": "number",
                  "enum": [
                    0.1,
                    0.3,
                    0.5,
                    0.7,
                    0.9
                  ]
                },
                "status": {
                  "enum": [
                    "supported",
                    "ambiguous",
                    "insufficient_evidence"
                  ]
                },
                "source_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "evidence_quote": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 220
                },
                "premise_safe": {
                  "type": "boolean"
                },
                "reviewed": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  }
}