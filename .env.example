# Optional. A catalog search URL you have verified by hand; {query} is replaced by the title.
# Leave empty to show only the Open Library link.
VITE_LOCAL_LIBRARY_SEARCH_URL=
VITE_LOCAL_LIBRARY_LABEL=Search our library

# Optional live availability via server/library-proxy.mjs (keeps the Data4Library key server-side).
# Run: DATA4LIBRARY_AUTH_KEY=... node server/library-proxy.mjs   then set:
VITE_LIBRARY_PROXY_URL=
VITE_LIBRARY_CODE=
VITE_LIBRARY_NAME=

# Optional community contributions + Supabase dataset (docs/community/DESIGN.md).
# Public values only: the anon key is safe in the browser; RLS and the submit_* functions guard writes.
# Without these two, the game runs fully offline and "add a book" says contributions are switched off.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional Cloudflare Turnstile site key (D1). Enable the same CAPTCHA in Supabase Auth, plus Anonymous sign-ins.
VITE_TURNSTILE_SITE_KEY=
# "supabase" = play the release loaded from get_release_catalog() (falls back to the bundled JSON).
VITE_CATALOG_SOURCE=
# Maintainer-only tooling (npm run community -- sync|pull|consensus|export). NEVER prefix with VITE_.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
